# ==============================================================================
# Primavera P6 PDS Table Selector - Example Configuration (.env.example)
# Copy this file to .env and fill in your credentials.
# ==============================================================================

PDS_USERNAME=your_p6_username
PDS_PASSWORD=your_p6_password

# PDS Service Endpoint
PDS_ORIGIN=https://us2.p6.oraclecloud.com/stackinfra/pds/rest-service/dataservice

# P6 Configuration Code
CONFIG_CODE=ds_p6adminuser

# Web Server Settings (0.0.0.0 for hosting / remote access, 127.0.0.1 for local only)
HOST=0.0.0.0
PORT=8765

# Auto open browser on start
AUTO_OPEN_BROWSER=true

# Optional comma-separated table allow-list (e.g. TASK,PROJECT,PROJWBS)
TABLES_OVERRIDE=
